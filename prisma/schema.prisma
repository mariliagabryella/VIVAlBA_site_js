// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// Exemplo básico de um evento no schema.prisma
model Event {
  id          Int      @id @default(autoincrement())
  title       String   // Nome do evento
  description String?  // Descrição (opcional, devido ao '?')
  date        DateTime // Data do evento
  location    String   // Local
  createdAt   DateTime @default(now())
}



enum Role {
  USER
  ADMIN
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String   // Password encriptada
  role      Role     @default(USER) // Cargo padrão é utilizador comum
  createdAt DateTime @default(now())
}